diff --git a/contrib/src/gme/rules.mak b/contrib/src/gme/rules.mak
index 2f02aee8b8407fd5f274688d648d3ad2df8e2309..43898b2b5d10b66ccbc7101aff559236dc6dc226 100644
--- a/contrib/src/gme/rules.mak
+++ b/contrib/src/gme/rules.mak
@@ -29,4 +29,9 @@ GME_CONF := -DENABLE_UBSAN=OFF
 	$(HOSTVARS) $(CMAKE) $(GME_CONF)
 	+$(CMAKEBUILD)
 	$(CMAKEINSTALL)
+ifdef HAVE_WIN32
+	# Let VLC's -static-libgcc select the runtime; CMake's implicit list
+	# otherwise forces the shared unwinder into the C plug-in link.
+	sed -i 's/-lgcc_s//g' $(PREFIX)/lib/pkgconfig/libgme.pc
+endif
 	touch $@
