diff --git a/contrib/src/main.mak b/contrib/src/main.mak
index a4a930dd5c67d383dfd11226da0514404b730054..4e79f5b39718252bf1fa4c57a7cf2007d94d1fc1 100644
--- a/contrib/src/main.mak
+++ b/contrib/src/main.mak
@@ -521,6 +521,10 @@ endif
 PKGS_FOUND :=
 include $(SRC)/*/rules.mak
 
+# An explicitly requested source build must also supply its dependencies to
+# other recipes, even when a different system version passes need_pkg().
+PKGS_FOUND := $(filter-out $(PKGS_ENABLE),$(PKGS_FOUND))
+
 ifeq ($(PKGS_DISABLE), all)
 PKGS :=
 endif
diff --git a/contrib/src/regex/rules.mak b/contrib/src/regex/rules.mak
index 2c02b225a9be5e30d2b799d67ec9adb0a6bf8424..097fb8a059fc7b4b759688565267ba3a6a6d1d64 100644
--- a/contrib/src/regex/rules.mak
+++ b/contrib/src/regex/rules.mak
@@ -20,7 +20,7 @@ regex: regex-$(REGEX_VERSION).tar.gz .sum-regex
 
 .regex: regex
 	cd $< && $(HOSTVARS) ./configure $(HOSTCONF)
-	$(MAKE) -C $< subirs=
+	$(MAKE) -C $< subirs= CFLAGS="$(CFLAGS)"
 	cd $< && $(AR) rcvu libregex.a regex.o && $(RANLIB) libregex.a
 	mkdir -p $(PREFIX)/include/ && cp $</regex.h $(PREFIX)/include/
 	mkdir -p $(PREFIX)/lib/ && cp $</libregex.a $(PREFIX)/lib/
