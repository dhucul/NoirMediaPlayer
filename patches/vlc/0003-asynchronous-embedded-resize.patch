+    PostMessage(p_event->hwnd, WM_VLC_UPDATE_GEOMETRY, 0, 0);
+}
+
+/* All child-window placement happens on their owning thread. Read the latest
+ * parent bounds rather than replaying sizes queued by the video/UI threads.
+ * The renderer still updates its resources through CommonManage/UpdateRects. */
+static void UpdateVideoWindow(event_thread_t *p_event, bool resize_parent)
+{
+    if (!p_event->hvideownd)
+        return;
+
+    RECT client;
+    const UINT flags = SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOCOPYBITS;
+    if (resize_parent && p_event->hparent &&
+        GetParent(p_event->hwnd) == p_event->hparent &&
+        GetClientRect(p_event->hparent, &client))
+    {
+        RECT current;
+        if (GetClientRect(p_event->hwnd, &current) &&
+            !EqualRect(&client, &current))
+            SetWindowPos(p_event->hwnd, NULL, 0, 0,
+                         client.right, client.bottom, flags);
+    }
+    if (!GetClientRect(p_event->hwnd, &client) ||
+        client.right <= 0 || client.bottom <= 0)
+        return;
+
+    vlc_mutex_lock(&p_event->lock);
+    video_format_t source = p_event->source;
+    vout_display_cfg_t cfg = p_event->cfg;
+    vlc_mutex_unlock(&p_event->lock);
+    cfg.display.width = client.right;
+    cfg.display.height = client.bottom;
+    vout_display_place_t place;
+    vout_display_PlacePicture(&place, &source, &cfg, false);
+
+    RECT current;
+    POINT origin = {0, 0};
+    if (!GetWindowRect(p_event->hvideownd, &current) ||
+        !ClientToScreen(p_event->hwnd, &origin) ||
+        current.left != origin.x + place.x ||
+        current.top != origin.y + place.y ||
+        current.right - current.left != (LONG)place.width ||
+        current.bottom - current.top != (LONG)place.height)
+        SetWindowPos(p_event->hvideownd, NULL, place.x, place.y,
+                     place.width, place.height, flags);
+
+    /* Mouse coordinates (including DVD menu buttons) use the applied bounds. */
+    vlc_mutex_lock(&p_event->lock);
+    p_event->place = place;
+    vlc_mutex_unlock(&p_event->lock);
 }
 
