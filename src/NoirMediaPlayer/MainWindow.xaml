<Window x:Class="NoirMediaPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:models="clr-namespace:NoirMediaPlayer.Models"
        mc:Ignorable="d"
        Title="NOIR — Cinema without clutter"
        Width="1440" Height="880" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="CanResize" Background="{StaticResource InkBrush}"
        AllowDrop="True" Loaded="Window_Loaded" Closing="Window_Closing"
        StateChanged="Window_StateChanged" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" BorderBrush="#FF252A33" BorderThickness="1" Background="{StaticResource InkBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="StatusBarRow" Height="28" />
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Background="#FF08090C" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" Background="{StaticResource AccentBrush}" CornerRadius="7">
                            <TextBlock Text="N" Foreground="#FF070905" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="13" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="N O I R" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="13"
                                   Margin="9,0,0,0" VerticalAlignment="Center" />
                        <Border Margin="9,0,0,0" Padding="6,2" Background="#FF181B20" CornerRadius="4">
                            <TextBlock Text="PLAYER" FontSize="8" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" />
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="WindowTitleText" Grid.Column="1" Text="Ready for a film"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource SidebarButton}" Padding="10,6" Margin="0" Click="OpenFile_Click" ToolTip="Open files (Ctrl+O)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" Margin="0,0,7,0" />
                                <TextBlock Text="Open" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="InspectorToggleButton" Style="{StaticResource SidebarButton}" Padding="10,6" Margin="2,0,0,0"
                                Click="ToggleInspector_Click" ToolTip="Show or hide inspector (I)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" Margin="0,0,7,0" />
                                <TextBlock x:Name="InspectorToggleText" Text="Hide inspector" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Width="32" Height="32"
                                Content="&#xE713;" Click="Settings_Click" ToolTip="Quick settings" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
                        <Button Content="&#xE8BB;" Click="Close_Click" ToolTip="Close">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TitleButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFE04747" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Player workspace -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="264" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="296" />
                </Grid.ColumnDefinitions>

                <!-- Queue / library -->
                <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="14,16,14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="SOURCES" Style="{StaticResource SectionLabel}" Margin="8,0,0,10" />
                        <StackPanel Grid.Row="1">
                            <Button Style="{StaticResource SidebarButton}" Click="OpenFile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="28" />
                                    <TextBlock Text="Open media" VerticalAlignment="Center" />
                                    <TextBlock Text="CTRL O" Foreground="{StaticResource MutedTextBrush}" FontSize="9"
                                               Margin="28,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButton}" Click="OpenFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="28" />
                                    <TextBlock Text="Open folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButton}" Click="OpenDisc_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE958;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="28" />
                                    <TextBlock Text="Play DVD / disc" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="EjectDiscButton" Style="{StaticResource SidebarButton}" Click="EjectDisc_Click"
                                    ToolTip="Eject the active optical disc (Ctrl+E)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏏" FontFamily="Segoe UI Symbol" FontSize="15" Width="28" />
                                    <TextBlock Text="Eject disc" VerticalAlignment="Center" />
                                    <TextBlock Text="CTRL E" Foreground="{StaticResource MutedTextBrush}" FontSize="9"
                                               Margin="40,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButton}" Click="OpenLocation_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="28" />
                                    <TextBlock Text="Open network stream" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,12,0,9">
                            <TextBox x:Name="PlaylistSearchBox" TextChanged="PlaylistSearch_TextChanged" Padding="32,8,9,8"
                                     ToolTip="Filter the queue" />
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource MutedTextBrush}"
                                       Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBlock x:Name="SearchHint" Text="Filter queue" Foreground="{StaticResource MutedTextBrush}"
                                       Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>

                        <Grid Grid.Row="3" Margin="7,0,4,5">
                            <TextBlock Text="QUEUE" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="QueueCountText" Text="0 ITEMS" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Grid.Row="4">
                            <ListBox x:Name="PlaylistView" SelectionChanged="PlaylistView_SelectionChanged"
                                     MouseDoubleClick="PlaylistView_MouseDoubleClick"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Width" Value="10" />
                                        <Setter Property="Margin" Value="4,2,0,2" />
                                        <Setter Property="Background" Value="#FF080A0D" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                        <Track x:Name="PART_Track" IsDirectionReversed="True"
                                                               Orientation="{TemplateBinding Orientation}"
                                                               Minimum="{TemplateBinding Minimum}"
                                                               Maximum="{TemplateBinding Maximum}"
                                                               Value="{TemplateBinding Value}"
                                                               ViewportSize="{TemplateBinding ViewportSize}">
                                                            <Track.DecreaseRepeatButton>
                                                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                                              Background="Transparent" BorderThickness="0"
                                                                              Focusable="False" />
                                                            </Track.DecreaseRepeatButton>
                                                            <Track.Thumb>
                                                                <Thumb Background="#FF424A56" MinHeight="32">
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border x:Name="ThumbChrome"
                                                                                    Margin="2,0"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    CornerRadius="3" />
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="ThumbChrome" Property="Background" Value="#FF697381" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsDragging" Value="True">
                                                                                    <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource AccentBrush}" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                            <Track.IncreaseRepeatButton>
                                                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                                              Background="Transparent" BorderThickness="0"
                                                                              Focusable="False" />
                                                            </Track.IncreaseRepeatButton>
                                                        </Track>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:PlaylistItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="6" Background="#FF191D24" VerticalAlignment="Center">
                                                <TextBlock x:Name="PlayMarker" Text="&#xE8B1;" FontFamily="{StaticResource IconFont}"
                                                           Foreground="{StaticResource MutedTextBrush}" FontSize="10"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="7,0,7,0">
                                                <TextBlock x:Name="ItemTitle" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="9"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KindText}" Foreground="{StaticResource MutedTextBrush}" FontSize="8" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter TargetName="ItemTitle" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="PlayMarker" Property="Text" Value="&#xE769;" />
                                                <Setter TargetName="PlayMarker" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="EmptyQueuePanel" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" Foreground="#FF343A44" FontSize="28" HorizontalAlignment="Center" />
                                <TextBlock Text="Your queue is empty" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,9,0,0" />
                                <TextBlock Text="Drop files anywhere" Foreground="{StaticResource MutedTextBrush}" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="5" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SavePlaylistButton" Style="{StaticResource NoirButton}" Padding="9,6" Click="SavePlaylist_Click" ToolTip="Save M3U playlist">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" />
                                    <TextBlock Text="Save" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="6,0,0,0"
                                    Content="&#xE74D;" Click="RemoveSelected_Click" ToolTip="Remove selected" />
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="6,0,0,0"
                                    Content="&#xE894;" Click="ClearPlaylist_Click" ToolTip="Clear queue" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Video surface and controls -->
                <Grid Grid.Column="1" Background="#FF020304">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="12,12,12,0" Background="#FF000000" CornerRadius="10" ClipToBounds="True"
                            BorderBrush="#FF171A20" BorderThickness="1">
                        <vlc:VideoView x:Name="VideoView" Background="#FF000000">
                            <Grid x:Name="VideoOverlay" Background="#FF000000" IsHitTestVisible="False">
                                <StackPanel x:Name="EmptyPlayerPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="82" Height="82" CornerRadius="26" Background="#D90D1015" BorderBrush="#FF242A33" BorderThickness="1">
                                        <Grid>
                                            <Ellipse Width="34" Height="34" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2" />
                                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}"
                                                       FontSize="15" Margin="3,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="MAKE THE ROOM GO QUIET" FontFamily="{StaticResource DisplayFont}" FontSize="16"
                                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,0" />
                                    <TextBlock Text="Open a film, drop a folder, or insert a disc" Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>

                                <Border x:Name="PlaybackNotice" Visibility="Collapsed" Background="#E515181E" CornerRadius="7"
                                        Padding="13,8" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,18,0,0">
                                    <TextBlock x:Name="PlaybackNoticeText" Foreground="{StaticResource ProminentTextBrush}"
                                               FontWeight="SemiBold" FontSize="11" />
                                </Border>

                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16" Background="#B20A0C10"
                                        CornerRadius="6" Padding="9,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="EngineStatusDot" Width="6" Height="6" Fill="#FF5E6672" Margin="0,0,7,0" />
                                        <TextBlock x:Name="EngineStatusText" Text="LIBVLC READY" Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="9" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </vlc:VideoView>
                    </Border>

                    <Border Grid.Row="1" MinHeight="116" Background="#FF080A0D" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,10,16,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Width="48" VerticalAlignment="Center" />
                                <Slider x:Name="TimelineSlider" Grid.Column="1" Minimum="0" Maximum="1000" Value="0"
                                        IsMoveToPointEnabled="True" PreviewMouseLeftButtonDown="Timeline_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="Timeline_PreviewMouseLeftButtonUp" />
                                <TextBlock x:Name="RemainingText" Grid.Column="2" Text="−0:00" Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10" Width="52" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid x:Name="TransportLayoutGrid" Grid.Row="1" Margin="0,7,0,0"
                                  SizeChanged="TransportLayout_SizeChanged">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel x:Name="TransportToolsPanel" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ShuffleButton" Style="{StaticResource TransportButton}" Content="&#xE8B1;" Click="Shuffle_Click" ToolTip="Shuffle (H)" />
                                    <Button x:Name="RepeatButton" Style="{StaticResource TransportButton}" Content="&#xE8EE;" Click="Repeat_Click" ToolTip="Repeat: Off (R)" />
                                    <Button Style="{StaticResource TransportButton}" Content="&#xE722;" Click="AddSubtitle_Click" ToolTip="Load subtitle (V)" />
                                    <Button Style="{StaticResource TransportButton}" Content="&#xEB9F;" Click="Snapshot_Click" ToolTip="Snapshot (S)" />
                                </StackPanel>

                                <StackPanel x:Name="PrimaryTransportPanel" Grid.Column="2" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource TransportButton}" Content="&#xE892;" Click="Previous_Click" ToolTip="Previous (Page Up)" />
                                    <Button Style="{StaticResource TransportButton}" Content="&#xE71A;" Click="Stop_Click" ToolTip="Stop" />
                                    <Button x:Name="PlayPauseButton" Style="{StaticResource AccentButton}" Width="52" Height="52" Padding="0"
                                            FontFamily="{StaticResource IconFont}" FontSize="19" Content="&#xE768;"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Click="PlayPause_Click" ToolTip="Play / pause (Space)" />
                                    <Button Style="{StaticResource TransportButton}" Content="&#xE893;" Click="Next_Click" ToolTip="Next (Page Down)" />
                                    <Button Style="{StaticResource TransportButton}" Content="&#xE8F5;" Click="ToggleCompact_Click" ToolTip="Mini player (P)" />
                                </StackPanel>

                                <StackPanel x:Name="VolumeControlsPanel" Grid.Column="4" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <ComboBox x:Name="SpeedComboBox" Width="68" Padding="8,0,22,0" SelectedIndex="3" SelectionChanged="Speed_SelectionChanged" ToolTip="Playback speed">
                                        <ComboBoxItem Content="0.50×" Tag="0.5" />
                                        <ComboBoxItem Content="0.75×" Tag="0.75" />
                                        <ComboBoxItem Content="0.90×" Tag="0.9" />
                                        <ComboBoxItem Content="1.00×" Tag="1" />
                                        <ComboBoxItem Content="1.25×" Tag="1.25" />
                                        <ComboBoxItem Content="1.50×" Tag="1.5" />
                                        <ComboBoxItem Content="2.00×" Tag="2" />
                                    </ComboBox>
                                    <Button x:Name="MuteButton" Style="{StaticResource TransportButton}" Content="&#xE767;" Click="Mute_Click" ToolTip="Mute (M)" />
                                    <Slider x:Name="VolumeSlider" Width="82" Minimum="0" Maximum="100" Value="82" Margin="0,0,8,0"
                                            ValueChanged="Volume_ValueChanged" ToolTip="Volume" />
                                    <Button Style="{StaticResource TransportButton}" Content="&#xE740;" Click="Fullscreen_Click" ToolTip="Fullscreen (F)" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Now playing inspector -->
                <Border x:Name="InspectorPanel" Grid.Column="2" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="18,17,18,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="NOW PLAYING" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Width="28" Height="28" HorizontalAlignment="Right"
                                        Click="ToggleInspector_Click" ToolTip="Hide inspector" />
                            </Grid>

                            <Border Height="142" CornerRadius="10" Background="#FF050608" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <Grid>
                                    <Ellipse Width="76" Height="76" Stroke="#FF232833" StrokeThickness="8" />
                                    <Ellipse Width="12" Height="12" Fill="{StaticResource AccentBrush}" />
                                    <TextBlock x:Name="ArtworkIcon" Text="&#xE8B2;" FontFamily="{StaticResource IconFont}" Foreground="#FF4D5561"
                                               FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,72,0,0" />
                                </Grid>
                            </Border>

                            <TextBlock x:Name="NowPlayingTitle" Text="Nothing queued" Foreground="{StaticResource ProminentTextBrush}"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="19"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,15,0,0" />
                            <TextBlock x:Name="NowPlayingSource" Text="Choose a source to begin" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                            <WrapPanel Margin="0,12,0,18">
                                <Border Background="#FF18221A" CornerRadius="4" Padding="7,3" Margin="0,0,5,5">
                                    <TextBlock x:Name="FormatBadge" Text="READY" Foreground="{StaticResource AccentBrush}" FontSize="8" FontWeight="Bold" />
                                </Border>
                                <Border Background="{StaticResource RaisedBrush}" CornerRadius="4" Padding="7,3" Margin="0,0,5,5">
                                    <TextBlock x:Name="ResolutionBadge" Text="—" Foreground="{StaticResource MutedTextBrush}" FontSize="8" FontWeight="Bold" />
                                </Border>
                                <Border Background="{StaticResource RaisedBrush}" CornerRadius="4" Padding="7,3" Margin="0,0,5,5">
                                    <TextBlock x:Name="RateBadge" Text="1.00×" Foreground="{StaticResource MutedTextBrush}" FontSize="8" FontWeight="Bold" />
                                </Border>
                            </WrapPanel>

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="TRACKS" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                                    <TextBlock Text="Audio" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,0,0,4" />
                                    <ComboBox x:Name="AudioTrackComboBox" SelectionChanged="AudioTrack_SelectionChanged">
                                        <ComboBoxItem Content="Default audio" Tag="-1" />
                                    </ComboBox>
                                    <TextBlock Text="Subtitles" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,11,0,4" />
                                    <ComboBox x:Name="SubtitleTrackComboBox" SelectionChanged="SubtitleTrack_SelectionChanged">
                                        <ComboBoxItem Content="Subtitles off" Tag="-1" />
                                    </ComboBox>
                                    <Button Style="{StaticResource NoirButton}" Margin="0,9,0,0" Padding="10,7" Click="AddSubtitle_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,0,7,0" />
                                            <TextBlock Text="Load external subtitle" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="VIEW" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                                    <TextBlock Text="Aspect ratio" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,0,0,4" />
                                    <ComboBox x:Name="AspectRatioComboBox" SelectedIndex="0" SelectionChanged="AspectRatio_SelectionChanged">
                                        <ComboBoxItem Content="Best fit" Tag="" />
                                        <ComboBoxItem Content="16:9" Tag="16:9" />
                                        <ComboBoxItem Content="16:10" Tag="16:10" />
                                        <ComboBoxItem Content="4:3" Tag="4:3" />
                                        <ComboBoxItem Content="1:1" Tag="1:1" />
                                        <ComboBoxItem Content="21:9" Tag="21:9" />
                                    </ComboBox>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource NoirButton}" Padding="7" Margin="0,0,4,0" Click="Rotate_Click">
                                            <TextBlock Text="Rotate 90°" FontSize="10" />
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource NoirButton}" Padding="7" Margin="4,0,0,0" Click="ToggleCompact_Click">
                                            <TextBlock Text="Mini player" FontSize="10" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="CHAPTERS" Style="{StaticResource SectionLabel}" Margin="0,0,0,9" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource NoirButton}" Padding="7" Margin="0,0,4,0" Click="PreviousChapter_Click">
                                            <TextBlock Text="Previous" FontSize="10" />
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource NoirButton}" Padding="7" Margin="4,0,0,0" Click="NextChapter_Click">
                                            <TextBlock Text="Next" FontSize="10" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Status strip -->
            <Border Grid.Row="2" Background="#FF08090C" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#FF5E6672" Margin="0,0,7,0" />
                        <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedTextBrush}" FontSize="9" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="SPACE" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text=" play/pause   " Foreground="{StaticResource MutedTextBrush}" FontSize="9" />
                        <TextBlock Text="F" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text=" fullscreen   " Foreground="{StaticResource MutedTextBrush}" FontSize="9" />
                        <TextBlock Text="← →" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text=" seek" Foreground="{StaticResource MutedTextBrush}" FontSize="9" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick settings popover -->
            <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Width="352" Background="#FC11141A" BorderBrush="#FF303640" BorderThickness="1"
                        CornerRadius="10" Padding="17" Margin="0,8,8,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="QUICK SETTINGS" Foreground="{StaticResource ProminentTextBrush}"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold" />
                            <TextBlock Text="NOIR" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <CheckBox x:Name="RememberPositionCheckBox" Content="Remember playback position" Margin="0,0,0,11"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                        <CheckBox x:Name="AutoPlayNextCheckBox" Content="Automatically play the next item" Margin="0,0,0,11"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                        <CheckBox x:Name="HardwareDecodingCheckBox" Content="Hardware-accelerated decoding" Margin="0,0,0,11"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                        <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Keep player above other windows" Margin="0,0,0,11"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                        <Separator Background="{StaticResource LineBrush}" Margin="0,3,0,12" />
                        <TextBlock Text="BLU-RAY AACS" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" />
                        <TextBlock x:Name="AacsStatusText" Text="AACS component not configured"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,9" />
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource NoirButton}" Click="ChooseAacsLibrary_Click" Padding="8,7">
                                <TextBlock Text="Choose alternate DLL" FontSize="9" ToolTip="Selected now; validated and applied after restarting NOIR" />
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource NoirButton}" Click="OpenAacsFolder_Click" Padding="8,7">
                                <TextBlock Text="Open key folder" FontSize="9" />
                            </Button>
                        </Grid>
                        <Button x:Name="DownloadKeysButton" Style="{StaticResource NoirButton}" Click="DownloadKeys_Click" Padding="8,7" Margin="0,0,0,11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Margin="0,0,7,0" />
                                <TextBlock Text="Download AACS keys" FontSize="9" />
                            </StackPanel>
                        </Button>
                        <Separator Background="{StaticResource LineBrush}" Margin="0,3,0,12" />
                        <Button Style="{StaticResource NoirButton}" Click="OpenSnapshotFolder_Click" Padding="10,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" />
                                <TextBlock Text="Open snapshot folder" FontSize="10" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="LibVLC engine · Keyboard-first controls · Local settings"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="8" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
