<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exercise exactly the backend compiled into NOIR, without loading VLC/AACS. -->
    <Compile Include="../../src/NoirMediaPlayer/Services/WindowsDvdSession.cs" Link="WindowsDvdSession.cs" />
    <Compile Include="../../src/NoirMediaPlayer/Services/WindowsDvdSession.Connections.cs" Link="WindowsDvdSession.Connections.cs" />
  </ItemGroup>
</Project>
